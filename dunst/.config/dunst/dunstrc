# For defaults and description of each option, see the link bellow
# https://github.com/dunst-project/dunst/blob/master/dunstrc

[global]
# Display
follow = mouse
width = 350
height = (0, 150)
origin = top-right
offset = (35, 35)
indicate_hidden = yes
notification_limit = 5
gap_size = 4
padding = 8
horizontal_padding = 10
frame_width = 1
sort = no

# Progress bar
progress_bar_frame_width = 0
progress_bar_corner_radius = 0

# Colors — base values overridden at runtime by launchdunst.sh via CLI flags
foreground = "#cdd1dc"
frame_color = "#ffffff"
highlight = "#ffffff, #cccccc"

# Text
font = Monospace 10
markup = full
format = "<b>%s</b>\n%b"
alignment = left
vertical_alignment = center
show_age_threshold = -1
hide_duplicate_count = false

# Icon
icon_position = off

# Misc/Advanced
dmenu = wofi --show drun --prompt 'Open with'
corner_radius = 0

# Mouse
mouse_left_click = close_current
mouse_middle_click = do_action, close_current
mouse_right_click = close_all

[urgency_low]
background = "#1a1b26f0"
timeout = 3

[urgency_normal]
background = "#1a1b26f0"
timeout = 8

[urgency_critical]
background = "#1a1b26f0"
frame_color = "#ffffff"
highlight = "#eb4d4b"
timeout = 0

# Rules
[fullscreen_delay_everything]
fullscreen = delay

[fullscreen_show_critical]
msg_urgency = critical
fullscreen = show

