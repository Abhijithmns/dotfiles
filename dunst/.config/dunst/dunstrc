[global]
    monitor = 0
    follow = mouse
    width = 300
    height = 500
    origin = top-right
    offset = 10x50

    transparency = 20
    frame_width = 1
    frame_color = "#eeeeee"

    corner_radius = 0
    padding = 8
    horizontal_padding = 8

    font = Hack 11
    line_height = 0

    separator_height = 0
    separator_color = frame

    idle_threshold = 120

    markup = full
    format = "<b>%s</b>\n%b"

    alignment = left
    vertical_alignment = center

    show_age_threshold = 60
    word_wrap = yes

    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false

    browser = firefox

    always_run_script = true
    title = Dunst

    class = Dunst

    sort = yes

    shrink = no

    indicate_hidden = yes

    history_length = 20

    dmenu = rofi -dmenu -p dunst:

    mouse_left_click = close_current
    mouse_middle_click = do_action
    mouse_right_click = close_all

# NORMAL
[urgency_low]
    background = "#1a1a1a"
    foreground = "#eeeeee"
    timeout = 5

# NORMAL
[urgency_normal]
    background = "#1a1a1a"
    foreground = "#eeeeee"
    timeout = 6

# URGENT
[urgency_critical]
    background = "#111111"
    foreground = "#ffffff"
    frame_color = "#ff5555"
    timeout = 0
